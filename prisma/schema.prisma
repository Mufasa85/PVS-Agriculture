generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Currency {
  FC
  USD
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  alt       String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  icon        String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          Int             @id @default(autoincrement())
  name        String
  slug        String          @unique
  description String          @db.Text
  category    String
  priceAmount Decimal?        @db.Decimal(12, 2)
  currency    Currency        @default(FC)
  unit        String? // ex: "/ plateau", "/ kg", "/ tête", "/ sac 50 kg"
  note        String? // ex: "12 500 FC à partir de 100 plateaux"
  badge       String? // ex: "Best-seller", "Dès"
  imageSrc    String          @db.Text
  imageAlt    String
  images      ProductImage[]
  comingSoon  Boolean         @default(false) // ex: Bovins / Caprins, pas encore disponibles
  onDemand    Boolean         @default(false) // ex: cultures agricoles produites à la demande
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@map("products")
}

model ContactMessage {
  id        Int       @id @default(autoincrement())
  nom       String
  telephone String
  email     String
  sujet     String?
  message   String    @db.Text
  isRead    Boolean   @default(false)
  isStarred Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  type      String   // PAGE_VIEW, PRODUCT_VIEW, SEARCH, CATEGORY_VIEW, QUOTE_REQUEST
  path      String
  referrer  String?  @db.Text
  userAgent String?  @db.Text
  ipAddress String?
  metadata  Json?    // { productId, categorySlug, query, device, country, browser }
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([path])
  @@map("analytics_events")
}

