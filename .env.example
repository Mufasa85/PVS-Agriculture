# ── Base de données (MySQL via Laragon en local) ────────────────────
DATABASE_URL="mysql://root:@localhost:3306/pvs_ongd"

# ── Authentification admin ───────────────────────────────────────────
# Générer un secret fort : openssl rand -base64 48
AUTH_SECRET="change-me-en-production"
# Compte super administrateur créé par `npm run db:seed`
ADMIN_EMAIL="admin@pvs-ongd.org"
ADMIN_PASSWORD="changeme123"

# ── Site public ──────────────────────────────────────────────────────
# URL canonique utilisée par le sitemap, robots.txt, Open Graph et JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Emails (réponses aux messages, mot de passe oublié) ─────────────
# resend | smtp | console (log en dev)
EMAIL_PROVIDER="console"
EMAIL_FROM="PVS ONGD <noreply@pvs-ongd.org>"
# Si EMAIL_PROVIDER=resend :
EMAIL_API_KEY=""
# Si EMAIL_PROVIDER=smtp :
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Formulaire de contact ────────────────────────────────────────────
# Destinataire des messages envoyés via /contact
CONTACT_TO_EMAIL=""
# Expéditeur affiché (fallback de EMAIL_FROM)
CONTACT_FROM_EMAIL=""
