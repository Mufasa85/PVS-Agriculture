# Base de données MySQL (Prisma)
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/pvs_ongd"

# URL publique canonique du site (utilisée par les métadonnées SEO,
# OpenGraph, JSON-LD). OBLIGATOIRE en production.
# Exemples :
#   NEXT_PUBLIC_SITE_URL="https://www.pvs-ongd.cd"
#   NEXT_PUBLIC_SITE_URL="https://pvs-agriculture.vercel.app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentification admin — utilisées uniquement par `npm run db:seed`
# pour créer le compte SUPER_ADMIN initial (stocké ensuite en base, table User).
ADMIN_EMAIL="admin@pvs-ongd.org"
ADMIN_PASSWORD="changeme123"

# Clé secrète pour signer les sessions admin (générer une chaîne aléatoire longue)
AUTH_SECRET="replace-with-a-long-random-secret-string"

# SMTP pour le formulaire de contact (Nodemailer) — Gmail
# IMPORTANT : N'utilisez PAS votre mot de passe Gmail habituel.
# Activez la validation en 2 étapes sur votre compte Google, puis créez un
# "Mot de passe d'application" (App Password) :
#   1. https://myaccount.google.com/security
#   2. Activer "Validation en deux étapes"
#   3. https://myaccount.google.com/apppasswords → créer un mot de passe (16 caractères)
#   4. Coller ce mot de passe ci-dessous (sans espaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="votre.adresse@gmail.com"
SMTP_PASS="abcd-efgh-ijkl-mnop"
CONTACT_FROM_EMAIL="votre.adresse@gmail.com"
CONTACT_TO_EMAIL="contact@pvs-ongd.org"
